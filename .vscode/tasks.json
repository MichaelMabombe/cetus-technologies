{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Servir site Cetus",
            "type": "process",
            "command": "${workspaceFolder}/scripts/serve-local.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "cetus-server",
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP",
                    "endsPattern": "^Serving HTTP"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
